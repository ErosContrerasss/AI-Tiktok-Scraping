SOCIALFETCH_API_KEY=sfk_...
# Set one of these; Anthropic (Claude Haiku) wins when both are present.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional
INGEST_MAX_PAGES=3
LLM_CONCURRENCY=8
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_MODEL=gemini-2.5-flash-lite
SEARCH_MODIFIERS=live,optreden,concert,show,festival,backstage,interview,podcast,meet and greet,tour
GEMINI_VISION_MODEL=gemini-2.5-flash
# TypeSafe Jev (https://docs.typesafe.ai). With a key set, Jev becomes the classifier unless CLASSIFIER=llm.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
CLASSIFIER=
# Media backend for thumbnails, frames, sheet photos and downloads (only "supabase" for now).
MEDIA_STORE=supabase
